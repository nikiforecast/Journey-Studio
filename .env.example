# Client-side (Vite) — copy to .env and fill in values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional
# VITE_RESTRICT_LOGIN_TO_LEGL_DOMAIN=true

# Server-side (Netlify functions) — add these to .env for `npx netlify dev`, and to Netlify dashboard for deploy:
OPENAI_API_KEY=sk-your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Must match VITE_SUPABASE_URL project. Use service_role from Supabase → Settings → API (NOT anon).
#
# Local dev: `npx netlify dev` (not `npm run dev` alone)
